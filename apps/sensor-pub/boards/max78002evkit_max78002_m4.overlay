/ {
	aliases {
		accel0 = &adxl367;
	};
};

&spi0 {
    status = "okay";

    adxl367: adxl367@0 {
        compatible = "adi,adxl367";
        reg = <0>;
        spi-max-frequency = <DT_FREQ_M(1)>;

        odr = <2>;
        // int1-gpios = <&gpio0 8 (GPIO_ACTIVE_LOW)>;
        friendly-name = "ADXL367 Accelerometer";
    };
};

// Used in micro-ROS transport configuration
usart1: &uart0 {};
